{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".vite/**",
    "work/**",
    "docs/**",
    "public/assets/**",
    "public/vendor/**"
  ]
}
